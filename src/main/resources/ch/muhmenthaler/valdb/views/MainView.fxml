<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ch.muhmenthaler.valdb.gui.controller.MainController"
            prefWidth="1000" prefHeight="650">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="220" spacing="8">
            <padding>
                <Insets top="12" right="8" bottom="12" left="8"/>
            </padding>
            <Button fx:id="collapseButton" text="&lt;&lt;" onAction="#onToggleCollapse" maxWidth="Infinity"/>
            <ListView fx:id="projectList" VBox.vgrow="ALWAYS"/>
            <Button fx:id="newProjectButton" text="+ New Project" onAction="#onNewProject" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <VBox>
            <padding>
                <Insets top="4" right="12" bottom="12" left="12"/>
            </padding>
            <HBox fx:id="viewSelector" spacing="8" visible="false" managed="false">
                <ToggleButton fx:id="sourcesToggle" text="Sources"/>
                <ToggleButton fx:id="snippetsToggle" text="Snippets"/>
            </HBox>
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="6" styleClass="status-bar">
                <padding><Insets top="4" right="0" bottom="0" left="0"/></padding>
                <Label text="A" style="-fx-font-size: 10px;"/>
                <Slider fx:id="fontSizeSlider" prefWidth="110"/>
                <Label text="A" style="-fx-font-size: 16px;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>